# Server
PORT=5000
NODE_ENV=development
APP_NAME=Zitheke
APP_BASE_URL=http://localhost:5173
PRIMARY_DOMAIN=

# MongoDB Atlas
MONGO_URI=mongodb+srv://MONGODB_USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/zitheke?retryWrites=true&w=majority

# Node DNS resolvers used for mongodb+srv lookups
DNS_SERVERS=1.1.1.1,8.8.8.8

# Automatic fallback that bypasses SRV DNS when Node returns querySrv ECONNREFUSED
MONGO_FALLBACK_HOSTS=YOUR_SHARD_00_HOST:27017,YOUR_SHARD_01_HOST:27017,YOUR_SHARD_02_HOST:27017
# Optional: paste an exact Atlas standard mongodb:// URI here to override the generated fallback
MONGO_FALLBACK_URI=
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_CONNECT_RETRIES=4
MONGO_RETRY_DELAY_MS=5000

# Authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=

# Firebase Admin: provide credentials securely. Do not commit real service-account JSON.
# Preferred: inline secret-manager JSON or an external path on the deployment host.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Infobip / OTP / email
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_EMAIL_SENDER=
INFOBIP_EMAIL_REPLY=
OTP_SENDER=
BRAND_SENDER=
OTP_ALLOWED_COUNTRY_CODE=265
INTERNAL_EMAIL_KEY=

# Turnstile
TURNSTILE_SECRET_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Airtel Money
AIRTEL_BASE_URL=https://openapiuat.airtel.mw
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=MW
AIRTEL_CURRENCY=MWK

# National Electronic Payment Gateway (NEPG) - NBM third-party API
# Base URL must include /api/v1, for example: https://YOUR_NEPG_HOST/api/v1
NEPG_ENABLED=false
NEPG_BASE_URL=
NEPG_CLIENT_ID=
NEPG_CLIENT_SECRET=
NEPG_API_KEY=
# Malawi numeric currency code used in the supplied NEPG integration document
NEPG_CURRENCY_CODE=454
# Optional explicit return URL. If blank, APP_BASE_URL + /checkout/nepg/return is used.
NEPG_RETURN_URL=
# CARD is the payment_method value shown in the supplied NEPG document.
NEPG_DEFAULT_PAYMENT_METHOD=CARD
NEPG_TIMEOUT_MS=20000

# Mastercard Payment Gateway Services
MPGS_ENABLED=false
MPGS_BASE_URL=https://test-nbm.mtf.gateway.mastercard.com
MPGS_API_VERSION=79
MPGS_MERCHANT_ID=
MPGS_API_USERNAME=
MPGS_API_PASSWORD=
MPGS_CURRENCY=MWK
MPGS_RETURN_URL=
MPGS_CANCEL_URL=
MPGS_ERROR_URL=

# Payment reconciliation
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_MAX_AGE_MINUTES=1440
PAYMENT_RECONCILIATION_BATCH_SIZE=20
PAYMENT_RECONCILIATION_MAX_RETRIES=20

# National Bank transfer (displayed to customers; not API secrets)
BANK_DISPLAY_NAME=National Bank
BANK_ACCOUNT_NAME=Alinafe Online Limited
BANK_ACCOUNT_NUMBER=1006477832
BANK_BRANCH=

# Advert boost expiry scheduler (default 5 minutes)
SUBSCRIPTION_EXPIRY_INTERVAL_MS=300000
